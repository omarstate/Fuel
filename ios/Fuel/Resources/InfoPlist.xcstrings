    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم Fuel الكاميرا لمسح باركود الأطعمة وتصوير ملصقات القيمة الغذائية لتسجيل الوجبات فورًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fuel uses the camera to scan food barcodes and photograph nutrition labels so meals can be logged instantly."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يستخدم Fuel الميكروفون علشان تسجّل وجبتك بصوتك، بالعامية المصرية أو بالإنجليزية."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fuel uses the microphone so you can log a meal by saying what you ate, in Egyptian Arabic or English."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يحوّل Fuel كلامك إلى نص علشان يطابق الأكل اللي قلته ويسجّله في وجباتك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Fuel turns what you say into text so your spoken meal can be matched to foods and logged."
          }
        }
      }
    }
  },
  "version" : "1.0"
}