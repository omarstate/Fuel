# Supabase — copy this file to .env.local and fill in your project's values.
# Find them in your Supabase dashboard: Project Settings → API
#   Project URL      -> VITE_SUPABASE_URL
#   Project API keys -> anon / public (a.k.a. "publishable") key -> VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Fuel Express backend — serves the shared meal catalog.
VITE_API_URL=http://localhost:4000/api
